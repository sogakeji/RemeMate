# RemeMate 环境变量样例（复制为 .env 填真实值；.env 不入 git）
FLASK_APP=wsgi:app
FLASK_ENV=development

# 三套数据库连接（角色分离见 docs/design/data-isolation-security.md）
DATABASE_URL=postgresql://rememate:CHANGE_ME@127.0.0.1:5432/rememate
MIGRATE_DATABASE_URL=postgresql://rememate_owner:CHANGE_ME@127.0.0.1:5432/rememate
DISPATCH_DATABASE_URL=postgresql://rememate_dispatch:CHANGE_ME@127.0.0.1:5432/rememate

# 测试库（独立于 dev！pytest 会清空它；绝不能指向 rememate）
TEST_DATABASE_URL=postgresql://rememate:CHANGE_ME@127.0.0.1:5432/rememate_test
TEST_DISPATCH_DATABASE_URL=postgresql://rememate_dispatch:CHANGE_ME@127.0.0.1:5432/rememate_test

# 密钥（生成：python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=CHANGE_ME
# DATA_ENCRYPTION_KEY 必须是 Fernet key：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CHANGE_ME

# LLM（DeepSeek，OpenAI 兼容）
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
