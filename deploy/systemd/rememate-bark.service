[Unit]
Description=RemeMate Bark review reminder dispatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/rememate
EnvironmentFile=/srv/rememate/.env
ExecStart=/usr/bin/flock -n /tmp/rememate-bark.lock /srv/rememate/.venv/bin/python -m dispatch.runner bark
