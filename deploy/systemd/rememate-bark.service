[Unit]
Description=RemeMate Bark review reminder dispatch
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/rememate
EnvironmentFile=/srv/rememate/.env
RuntimeDirectory=rememate
ExecStart=/srv/rememate/.venv/bin/python -u -m dispatch.runner bark --flock-lock /run/rememate/bark.lock
